# A template: nginx fills ${RUSCORD_*} from the environment when the
# container starts (only those, NGINX_ENVSUBST_FILTER in the Dockerfile).
# RUSCORD_CSP_CONNECT adds hosts the page may connect to: LiveKit Cloud
# (ruscord-core docs/adr/0034-livekit-cloud.md); empty by default.
#
# The client and ruscord-core on one origin: cookies (SameSite) and the
# gateway's Origin check need it. "core" is the ruscord-core service
# (RUSCORD_HTTP_ADDR=0.0.0.0:8080); its RUSCORD_ALLOWED_ORIGINS must list
# this site's origin.
upstream core_upstream {
    server core:8080;
}

server {
    listen 80;
    server_name _;
    root /app/frontend;
    index index.html;

    # Uploads (avatars, icons) are up to 8 MiB.
    client_max_body_size 9m;

    server_tokens off;

    location / {
        try_files $uri /index.html;
        # The page may run only its own scripts and talk only to its own
        # origin; nobody may frame it (clickjacking). Component styles are
        # inline <style> elements, hence 'unsafe-inline' for styles only.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self' ws://$http_host wss://$http_host ${RUSCORD_CSP_CONNECT}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=()" always;
    }

    location /api/ {
        proxy_pass http://core_upstream;
        include proxy_params;
    }

    # Attachments are up to 25 MiB (ruscord-core docs/adr/0036-attachments.md).
    # Passed on as they come: the core spools them itself.
    location ~ ^/api/v1/channels/[0-9a-f-]+/attachments$ {
        client_max_body_size 26m;
        proxy_request_buffering off;
        proxy_pass http://core_upstream;
        include proxy_params;
    }

    # Files never change under one link; the core sets the caching and
    # security headers (attachments need a signed link).
    location /cdn/ {
        proxy_pass http://core_upstream;
        include proxy_params;
    }

    # LiveKit signalling on this origin: the client connects to
    # /livekit/rtc/..., LiveKit gets /rtc/... (media itself goes straight to
    # LiveKit over UDP). Resolved per request, so nginx starts even when
    # LiveKit is not up yet.
    location /livekit/ {
        resolver 127.0.0.11 valid=10s;
        set $livekit http://livekit:7880;
        rewrite ^/livekit/(.*)$ /$1 break;
        proxy_pass $livekit;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        include proxy_params;
    }

    location = /gateway {
        proxy_pass http://core_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s; # heartbeats come every 30 s
        include proxy_params;
    }
}
